# Copy to .env and adjust. Every variable is prefixed with APP_.
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# Provider: fake (offline) | vllm (your local GPU) | anthropic
APP_LLM_PROVIDER=vllm

# --- vLLM -------------------------------------------------------------------
# Where vLLM listens (from the host). In docker compose, the api service
# overrides this with host.docker.internal.
APP_VLLM_BASE_URL=http://localhost:8000/v1
# MUST equal the id from `make vllm-check` (HF repo id, or --served-model-name).
APP_VLLM_MODEL=Qwen/Qwen3.5-4B
# Only if you started vLLM with --api-key
# APP_VLLM_API_KEY=
APP_VLLM_GUIDED_JSON=true
APP_VLLM_ENABLE_THINKING=false

# --- Anthropic (alternative) --------------------------------------------------
# APP_ANTHROPIC_API_KEY=sk-ant-...

# --- Tuning for a local GPU ---------------------------------------------------
# First request after vLLM start can be slow (CUDA graph capture / warm-up).
APP_LLM_TIMEOUT_S=60
APP_LLM_MAX_RETRIES=2
# vLLM batches concurrent requests on the GPU, so this can be much higher than
# for a hosted API. Raise it until latency per request starts to climb.
APP_LLM_MAX_CONCURRENCY=16
APP_STRUCTURED_MAX_REPAIRS=2
