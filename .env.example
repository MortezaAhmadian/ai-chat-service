# Copy to .env and adjust. Every variable is prefixed with APP_.
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# "fake" runs fully offline. Switch to "anthropic" and set a key for real calls.
APP_LLM_PROVIDER=fake
# APP_ANTHROPIC_API_KEY=sk-ant-...
# APP_ANTHROPIC_MODEL=claude-sonnet-5-5

APP_LLM_TIMEOUT_S=30
APP_LLM_MAX_RETRIES=3
APP_LLM_MAX_CONCURRENCY=8
APP_STRUCTURED_MAX_REPAIRS=2
